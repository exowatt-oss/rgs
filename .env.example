# Demo is deliberately offline and synthetic. NEVER expose mode=none to a network.
APP_ENV=local
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/app
FORWARDED_AUTH_MODE=none
FORWARDED_AUTH_ALLOW_INSECURE_NONE_MODE=1
ASR_PROVIDER=mock
LIVE_GATE_PROVIDER=mock
LIVE_DIARIZER=nemotron
LIVE_EMBED_ENABLED=false
LIVE_NAMING_ENABLED=false
RECAP_ENABLED=false
LIVE_FALLBACK_AFTER_S=0
LIVE_AUDIO_RETENTION_EMAILS=
# To deploy with verified identity, remove the none-mode lines and set
# FORWARDED_AUTH_ISSUER, FORWARDED_AUTH_AUDIENCE,
# FORWARDED_AUTH_ALLOWED_EMAIL_DOMAINS and optional FORWARDED_AUTH_JWKS_URL.
# A deployment exposing /mcp MUST set
# FORWARDED_AUTH_TRUSTED_HOSTNAMES=your-rgs.example.org
# (comma-separated public hostnames). Forwarded/OIDC mode rejects MCP requests
# without it; loopback hosts are NOT trusted by default. Never set
# FORWARDED_AUTH_ALLOW_LOOPBACK_HOSTS=true in production.
# To use a real model, set ASR_PROVIDER=nemotron and NEMOTRON_BASE_URL
# (plus NEMOTRON_API_KEY if required by the operator's own endpoint).
# Optional gate: LIVE_GATE_PROVIDER=jev with JEV_API_KEY, or
# LIVE_GATE_PROVIDER=openai with OPENAI_DECISIONS_API_KEY.
